# Secrets and local state: NEVER commit
# data/ holds the vault master key, the session-signing key and the database
# (encrypted API keys, users, leads). Each deployment generates its own.
data/
*.db
*.db-journal
*.db-wal
*.db-shm
.env
.env.*
.gtm_*

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Internal documents (not code)
/*.pdf
.dist/
